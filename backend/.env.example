# QuantBridge Configuration
QUANTBRIDGE_HOST=0.0.0.0
QUANTBRIDGE_PORT=8000
QUANTBRIDGE_DEBUG=true
QUANTBRIDGE_SECRET_KEY=change-this-to-a-random-secret-key

# Database (default: SQLite)
QUANTBRIDGE_DB_URL=sqlite+aiosqlite:///./quantbridge.db

# CORS (comma-separated origins)
QUANTBRIDGE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: Redis for caching
QUANTBRIDGE_REDIS_URL=

# Optional: API Keys for enhanced data
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
NEWS_API_KEY=

# FRED (Federal Reserve Economic Data) - Get free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
